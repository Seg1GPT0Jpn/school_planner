<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="1dp"
    android:paddingEnd="1dp"
    android:paddingTop="2dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/cell_day"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/tsuzuri_w_text"
        android:textSize="12sp" />

    <TextView android:id="@+id/cell_e1" style="@style/TsuzuriCellChip" />
    <TextView android:id="@+id/cell_e2" style="@style/TsuzuriCellChip" />
    <TextView android:id="@+id/cell_e3" style="@style/TsuzuriCellChip" />
    <TextView android:id="@+id/cell_e4" style="@style/TsuzuriCellChip" />
    <TextView android:id="@+id/cell_e5" style="@style/TsuzuriCellChip" />
    <TextView android:id="@+id/cell_e6" style="@style/TsuzuriCellChip" />
</LinearLayout>
